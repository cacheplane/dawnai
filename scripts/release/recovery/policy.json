{
  "ci": {
    "checks": ["harness-verify", "pack-smoke", "validate"],
    "workflow": ".github/workflows/ci.yml"
  },
  "environment": {
    "architecture": "x64",
    "containment": "systemd-cgroup-v2",
    "dockerImages": ["pgvector/pgvector:pg16", "postgres:16"],
    "node": "24.17.0",
    "packageManager": "npm@11.17.0",
    "platform": "linux",
    "profile": "recovery-linux-v2"
  },
  "fence": { "concurrencyGroup": "dawn-release-controller", "contracts": [] },
  "lanes": [
    {
      "name": "metadata",
      "packageChecks": "each-manifest-package",
      "requiredChecks": [
        "cleanup",
        "containment",
        "manifest",
        "official-npm-audit",
        "official-npm-audit-cleanup",
        "registry-packages"
      ]
    },
    {
      "name": "published-harness",
      "packageChecks": "none",
      "requiredChecks": [
        "ag-ui",
        "cleanup",
        "cleanup-docker-probe",
        "containment",
        "docker-pid-recovery",
        "exact-install",
        "framework-assertions",
        "manifest",
        "npm-signatures",
        "runtime-assertions",
        "smoke-assertions",
        "temporary-project",
        "typescript-tooling"
      ]
    },
    {
      "name": "runtime-targets",
      "packageChecks": "none",
      "requiredChecks": [
        "cleanup",
        "containment",
        "edge-bundle",
        "edge-import",
        "exact-install",
        "node-runtime",
        "probe-files",
        "temporary-project"
      ]
    },
    {
      "name": "scaffold",
      "packageChecks": "none",
      "requiredChecks": [
        "build",
        "cleanup",
        "containment",
        "dependency-install",
        "exact-versions",
        "runtime",
        "scaffold-create",
        "scaffolder-install",
        "temporary-project",
        "typecheck"
      ]
    },
    {
      "name": "storage",
      "packageChecks": "none",
      "requiredChecks": [
        "cleanup",
        "cleanup-pgvector",
        "cleanup-postgres",
        "cleanup-project",
        "containment",
        "docker",
        "exact-install",
        "pgvector-database",
        "pgvector-runtime",
        "postgres-database",
        "postgres-runtime",
        "temporary-project"
      ]
    }
  ],
  "receiptVersions": [2],
  "retry": {
    "fenceFreshnessMs": 30000,
    "initialBackoffMs": 1000,
    "maxRetryAfterMs": 15000,
    "operationDeadlineMs": 90000,
    "phaseDeadlineMs": 1200000,
    "readTimeoutMs": 15000,
    "transportRetries": 5
  },
  "schemaVersion": 2,
  "status": "DORMANT",
  "verifierClosure": {
    "inputs": [
      "scripts/lib/published-artifacts.mjs",
      "scripts/lib/readme-contracts.mjs",
      "scripts/lib/typescript-tooling-probe.mjs",
      "scripts/published-artifact-smoke.mjs",
      "scripts/published-artifact-verify.mjs",
      "scripts/release/adapter-normalize.mjs",
      "scripts/release/adapters/http.mjs",
      "scripts/release/adapters/npm.mjs",
      "scripts/release/limits.mjs",
      "scripts/release/manifest.mjs",
      "scripts/release/npm-audit.mjs",
      "scripts/release/recovery/schema.mjs",
      "scripts/release/semver.mjs",
      "scripts/release/smoke-command-shim.mjs",
      "scripts/release/smoke-containment.mjs",
      "scripts/release/smoke-process-runner.mjs",
      "scripts/release/smoke-result.mjs",
      "scripts/release/smoke/docker-identity.mjs",
      "scripts/release/smoke/published-harness.mjs",
      "scripts/release/smoke/runtime-targets.mjs",
      "scripts/release/smoke/scaffold.mjs",
      "scripts/release/smoke/storage.mjs",
      "scripts/release/topology.mjs"
    ],
    "sha256": "2f32e9a6d68b083e3b88aa0033b6b06dd972a5188ab0f87323a8aadc14216802"
  },
  "workflows": [
    ".github/workflows/release-postpublication-audit.yml",
    ".github/workflows/release-postpublication.yml"
  ]
}
