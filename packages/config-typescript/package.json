{
  "name": "@dawn-ai/config-typescript",
  "version": "0.8.26",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "Shared TypeScript compiler configurations for Dawn packages and applications.",
  "keywords": [
    "dawn",
    "typescript",
    "tsconfig",
    "configuration",
    "nodejs",
    "nextjs"
  ],
  "homepage": "https://github.com/cacheplane/dawnai/tree/main/packages/config-typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cacheplane/dawnai.git",
    "directory": "packages/config-typescript"
  },
  "bugs": {
    "url": "https://github.com/cacheplane/dawnai/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "*.json"
  ],
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  },
  "exports": {
    ".": "./base.json",
    "./base": "./base.json",
    "./library": "./library.json",
    "./node": "./node.json",
    "./nextjs": "./nextjs.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "biome check --config-path ../config-biome/biome.json package.json *.json scripts/validate.mjs",
    "typecheck": "node ./scripts/validate.mjs"
  }
}
