{
  "name": "@dawn-ai/memory",
  "version": "0.8.21",
  "private": false,
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/cacheplane/dawnai/tree/main/packages/memory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cacheplane/dawnai.git",
    "directory": "packages/memory"
  },
  "bugs": {
    "url": "https://github.com/cacheplane/dawnai/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browse": {
      "types": "./dist/browse.d.ts",
      "default": "./dist/browse.js"
    },
    "./namespace": {
      "types": "./dist/namespace.d.ts",
      "default": "./dist/namespace.js"
    },
    "./reconcile": {
      "types": "./dist/reconcile.d.ts",
      "default": "./dist/reconcile.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "lint": "biome check --config-path ../config-biome/biome.json package.json src tsconfig.json vitest.config.ts",
    "test": "vitest --run --config vitest.config.ts --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dawn-ai/sqlite-storage": "workspace:*"
  },
  "devDependencies": {
    "@dawn-ai/config-typescript": "workspace:*",
    "@types/node": "26.1.2"
  }
}
