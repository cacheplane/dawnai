{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../config-typescript/nextjs.json",
  "compilerOptions": {
    "incremental": true,
    "paths": { "@/*": ["./*"] }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "test/fixtures"]
}
